# AGROVERSE AI — Environment Configuration Example
# Copy this file to .env and configure real values. NEVER commit real secrets to Git.

# Database (External Postgres for Vercel/Production)
DATABASE_URL=postgresql://user:password@hostname:5432/agroverse

# Authentication & Security
JWT_SECRET=your_jwt_secret_min_32_chars_long
CRON_SECRET=your_vercel_cron_bearer_token

# CORS Allowed Origins (Comma-separated for web & mobile clients)
ALLOWED_ORIGINS=https://swayamgulhane538.github.io,https://agroverse-ai.vercel.app,http://localhost:3000

# Indian Mandi Data (OGD Platform India - data.gov.in)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# NASA Earthdata & POWER
EARTHDATA_USERNAME=your_nasa_earthdata_username
EARTHDATA_TOKEN=your_nasa_earthdata_token
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# LLM Advisory Service (Google Gemini / OpenAI)
LLM_API_KEY=your_llm_api_key

# Mobile App Client Configuration (Expo)
EXPO_PUBLIC_API_URL=https://agroverse-ai.vercel.app
