# AGROVERSE AI Environment Variables

# Backend API
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=True
JWT_SECRET=agroverse_super_secret_jwt_key_2026_hackathon_demo
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + PostGIS)
DATABASE_URL=sqlite:///./agroverse.db
# For Docker / Production: postgresql://agroverse:agroverse_pass@localhost:5432/agroverse_db

# NASA Earthdata & POWER
EARTHDATA_USERNAME=your_nasa_earthdata_username
EARTHDATA_TOKEN=your_nasa_earthdata_token
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Indian Market Data (data.gov.in)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Mobile App
EXPO_PUBLIC_API_URL=http://localhost:8000/v1
